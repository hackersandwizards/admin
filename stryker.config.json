{
  "mutate": ["src/{items,repo}.ts", "site/src/data.ts"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "test/vitest.mutation.config.ts",
    "pool": "forks",
    "related": false
  },
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": ".stryker-reports/mutation.json"
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always",
  "ignorePatterns": [
    ".*",
    "/bin/",
    "/site/src/admin.js",
    "/site/src/theme.js",
    "/src/build.ts",
    "/src/hub.ts",
    "/src/serve.ts",
    "/test/admin.test.ts"
  ],
  "concurrency": 2,
  "ignoreStatic": true,
  "incremental": true,
  "incrementalFile": ".stryker-reports/incremental.json"
}
