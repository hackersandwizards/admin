{
  "statusLine": {
    "type": "command",
    "command": "bash .claude/statusline-command.sh"
  },
  "advisorModel": "claude-fable-5-2",
  "claudeMdExcludes": ["/Users/*/.claude/rules/**", "/home/*/.claude/rules/**"],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.githooks/session-start\""
          }
        ]
      }
    ]
  }
}
