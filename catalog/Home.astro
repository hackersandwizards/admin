---
// Only utilities site/src uses work here: the stylesheet scans site/src only.
import Home from "@hackersandwizards/scaffolding/catalog/Home.astro";
// The brand version the tiles name is the installed one, which brand-elements compares them with.
import { version } from "@hackersandwizards/brand/package.json";
import catalogs from "@hackersandwizards/brand/catalogs.json";
import ItemGroups from "../site/src/components/ItemGroups.astro";
import elements from "../brand-elements.json";
import { withElements } from "../src/repo.ts";
import { items } from "./story";

const brand = catalogs.find((c) => c.name === "Brand")!;
const anchor = (name: string) => brand.portal + brand.anchors!.element.replace("<element>", name);
const notes: Record<string, string> = {
  label: "The rail's group names.",
  pill: "The recommended option among an item's options.",
  button: "Copy answers, and an item's Pick recommended and Reset.",
  card: "A row group, a dashboard figure, an option, a review image.",
  callout: "What an agent assumed or a person decided, above the item's text.",
  quote: "A blockquote in a report or an item's Markdown.",
  table: "Every list of rows: repositories, reports, scripts, checks, commits.",
  link: "A link in an item's text or a report.",
  code: "A code block in an item's Markdown or a report.",
  "inline-code": "A config key or command named in running text.",
  segmented: "The choice whose questions show: one person or all.",
  check: "An option to tick or pick, and a work item's done box.",
  breadcrumb: "The top bar's way back to the hub, its last item the repo switcher.",
  prose: "A report or document read on its doc page.",
  field: "The rail's search field.",
  search: "The rail's search, with its icon.",
  nav: "The rail: the repository's pages, the hub's repositories, with their counts.",
  choice: "The rail's menu on a phone, one row under the search.",
  menu: "The repo switcher's list of repositories, opened from the top bar.",
  disclosure: "A priority group, a person waited on, an item row: each opens and closes.",
};
---

<Home>
  <p class="mb-4 text-ui">
    {elements.uses.length} elements from brand, {Object.keys(elements.exceptions).length} kept as
    the engine's own.
  </p>
  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    {elements.uses.map((name) => (
      <div class="flex flex-col gap-2" data-hw-tile={name} data-hw-version={version}>
        <p class="text-ui">
          from brand v{version} · <code class="hw-inline-code">hw-{name}</code> ·{" "}
          <a class="hw-link" href={anchor(name)}>
            catalog
          </a>
        </p>
        <p class="text-ui text-foreground/70">{notes[name]}</p>
        {name === "label" && <p class="hw-label">spoke</p>}
        {name === "pill" && (
          <p class="flex flex-wrap gap-2">
            <span class="hw-pill" data-caps>
              Recommended
            </span>
            <span class="hw-pill" data-tone="neutral">
              optional
            </span>
          </p>
        )}
        {name === "button" && (
          <p class="flex flex-wrap gap-2">
            <button type="button" class="hw-button">
              Copy answers
            </button>
            <button type="button" class="hw-button" data-variant="secondary">
              Reset
            </button>
          </p>
        )}
        {name === "card" && <div class="hw-card text-ui">Open questions</div>}
        {name === "callout" && (
          <p class="hw-callout text-ui">
            <b>Assumed:</b> the cache stays in node_modules.
          </p>
        )}
        {name === "quote" && <blockquote class="hw-quote">Ship the smaller one.</blockquote>}
        {name === "table" && (
          <table class="hw-table w-full">
            <tbody>
              <tr>
                <td class="font-mono">check</td>
                <td class="font-mono">bun run lint && bun test</td>
              </tr>
            </tbody>
          </table>
        )}
        {name === "link" && (
          <p class="text-ui">
            See{" "}
            <a class="hw-link" href="#">
              the sample topic
            </a>{" "}
            first.
          </p>
        )}
        {name === "segmented" && (
          <div class="hw-segmented" role="group" aria-label="For whom">
            <button type="button" aria-pressed="true">
              Alex
            </button>
            <button type="button" aria-pressed="false">
              All
            </button>
          </div>
        )}
        {name === "check" && (
          <div class="flex flex-col gap-1 text-ui">
            <label class="flex items-start gap-2">
              <input type="checkbox" class="hw-check" checked /> Option A
            </label>
            <label class="flex items-start gap-2">
              <input type="checkbox" class="hw-check" /> Option B
            </label>
            <label class="flex items-start gap-2">
              <input type="radio" class="hw-check" name="check-tile" checked /> One
            </label>
            <label class="flex items-start gap-2">
              <input type="radio" class="hw-check" name="check-tile" /> Other
            </label>
          </div>
        )}
        {name === "breadcrumb" && (
          <nav class="hw-breadcrumb" aria-label="Breadcrumb">
            <ol>
              <li>
                <a href="#">Hub</a>
              </li>
              <li>
                <button
                  type="button"
                  class="hw-button"
                  data-variant="secondary"
                  aria-current="location"
                >
                  spoke <span aria-hidden="true">▾</span>
                </button>
              </li>
            </ol>
          </nav>
        )}
        {name === "field" && <input class="hw-field" type="search" aria-label="Search" />}
        {name === "search" && (
          <div class="hw-search">
            <input class="hw-field" type="search" aria-label="Search" placeholder="Search /" />
          </div>
        )}
        {name === "nav" && (
          <nav class="hw-nav" aria-label="Menu">
            <p class="hw-label hw-nav-group" data-tone="muted">
              spoke
            </p>
            <ul>
              <li>
                <a href="#">Dashboard</a>
              </li>
              <li>
                <a href="#" aria-current="page">
                  Decisions <span class="hw-nav-count">4</span>
                </a>
              </li>
            </ul>
          </nav>
        )}
        {name === "choice" && (
          <nav class="hw-choices" aria-label="Menu">
            <a class="hw-choice" href="#">
              Dashboard
            </a>
            <a class="hw-choice" href="#" aria-current="page">
              Decisions <span class="hw-choice-count">4</span>
            </a>
          </nav>
        )}
        {name === "menu" && (
          <div class="hw-menu" role="menu" aria-label="Repos">
            <a class="hw-menu-item" role="menuitemradio" aria-checked="true" href="#">
              spoke
            </a>
            <a class="hw-menu-item" role="menuitemradio" aria-checked="false" href="#">
              plain
            </a>
          </div>
        )}
        {name === "disclosure" && (
          <details class="hw-disclosure" open>
            <summary class="py-2 font-mono font-semibold text-ui">Priority 1</summary>
            <p class="text-ui">Two items wait on a decision.</p>
          </details>
        )}
        {name === "code" && <pre class="hw-code">bun run check</pre>}
        {name === "prose" && (
          <article
            class="prose hw-prose"
            set:html={withElements(
              Bun.markdown.html("Done when:\n\n- [x] Draft the report.\n- [ ] Review it.\n"),
            )}
          />
        )}
        {name === "inline-code" && (
          <p class="text-ui">
            Set <code class="hw-inline-code">admin.designSystem</code> in package.json.
          </p>
        )}
      </div>
    ))}
  </div>
  <h3>Kept as the engine's own</h3>
  <div class="grid gap-4 xl:grid-cols-3">
    {Object.entries(elements.exceptions).map(([name, reason]) => (
      <section class="flex flex-col gap-2" data-hw-exception={name}>
        <p class="font-medium text-ui">{name}</p>
        <p class="text-ui text-foreground/70">{reason}</p>
        {name === "item-list" && <ItemGroups items={items.slice(0, 2)} title="Priority 1" />}
        {name === "priority-pill" && (
          <p class="flex flex-wrap gap-2">
            <span class="hw-pill font-mono" data-priority="1">
              P1
            </span>
            <span class="hw-pill font-mono" data-priority="2">
              P2
            </span>
            <span class="hw-pill font-mono" data-priority="3">
              P3
            </span>
            <span class="hw-pill font-mono" data-variant="outline">
              P–
            </span>
          </p>
        )}
        {name === "image-tile" && (
          <span class="hw-card flex flex-col gap-1 p-2!">
            <span class="aspect-video w-full rounded-brand bg-muted" />
            <span class="truncate font-mono text-micro text-foreground/70">variant-a.svg</span>
          </span>
        )}
      </section>
    ))}
  </div>
</Home>
