{
  "name": "@hackersandwizards/admin",
  "version": "1.21.1",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.0",
    "npm": "please-use-bun"
  },
  "bin": {
    "admin-serve": "bin/admin-serve.ts",
    "admin-check": "bin/admin-check.ts"
  },
  "exports": {},
  "files": [
    "bin",
    "src",
    "site/src",
    "catalog/*.ts",
    "catalog/*.astro",
    "catalog/stories",
    "brand-elements.json",
    "test/fixtures/spoke"
  ],
  "scripts": {
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && git config core.hooksPath .githooks || true",
    "dev": "bun bin/admin-serve.ts",
    "start": "bun run dev",
    "catalog": "ASTRO_DEV_BACKGROUND=1 bun --bun astro dev --root catalog",
    "build": "check-lock bun --bun astro build --root catalog",
    "check": "scaffolding check",
    "check:values": "bun test/no-values.ts",
    "check:fixture": "bun bin/admin-check.ts test/fixtures/spoke",
    "check:colours": "brand-colours",
    "check:copies": "brand-copies",
    "check:elements": "brand-elements",
    "check:markers": "brand-markers --site dist /catalog/stories/Pages/doc/default/ /catalog/stories/Pages/decisions/default/",
    "check:retired": "brand-retired dist",
    "check:staged": "check-staged",
    "fix": "bun --bun eslint --cache --concurrency=auto . --fix && bun --bun prettier --write .",
    "test": "bun test"
  },
  "devDependencies": {
    "@hackersandwizards/brand": "git+https://github.com/hackersandwizards/brand.git#v2.8.1",
    "@hackersandwizards/scaffolding": "git+https://github.com/hackersandwizards/scaffolding.git#v5.8.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.5",
    "@types/bun": "1.4.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "astro": "7.4.8",
    "astrobook": "0.13.3",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "stylelint": "18.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "scaffolding": {
    "test": "test",
    "check": [
      "check:values",
      [
        "check:colours",
        "check:copies"
      ],
      "check:fixture",
      "check:elements",
      "check:markers",
      "check:retired"
    ],
    "skip": {
      "admin": "this is admin: check:fixture runs admin-check on the invented fixture, and the repository keeps no items of its own"
    }
  },
  "peerDependencies": {
    "@hackersandwizards/brand": ">=2.8.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "@hackersandwizards/brand": {
      "optional": true
    },
    "@tailwindcss/typography": {
      "optional": true
    },
    "@tailwindcss/vite": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "overrides": {
    "minimatch": "11.0.5",
    "postcss-selector-parser": "7.1.7"
  }
}
