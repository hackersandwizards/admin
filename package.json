{
  "name": "@hackersandwizards/admin",
  "version": "1.42.3",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": ">=1.4.0",
    "npm": "please-use-bun"
  },
  "bin": {
    "admin-serve": "bin/admin-serve.ts",
    "admin-check": "bin/admin-check.ts"
  },
  "exports": {},
  "files": [
    "bin",
    "src",
    "site/src",
    "catalog/*.ts",
    "catalog/*.astro",
    "!catalog/.astro",
    "catalog/stories",
    "brand-elements.json",
    "docs/hub.md",
    "docs/items.md",
    "test/fixtures/spoke"
  ],
  "scripts": {
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && git config core.hooksPath .githooks || true",
    "dev": "bun bin/admin-serve.ts",
    "catalog": "ASTRO_DEV_BACKGROUND=1 bun --bun astro dev --root catalog",
    "build": "check-lock bun --bun astro build --root catalog",
    "check": "scaffolding check",
    "check:values": "bun test/no-values.ts",
    "check:fixture": "bun bin/admin-check.ts test/fixtures/spoke",
    "check:scan": "brand-scan",
    "check:markers": "brand-markers --site dist /catalog/stories/Pages/doc/default/ /catalog/stories/Pages/decisions/default/",
    "check:staged": "check-staged",
    "test": "scaffolding test",
    "mutation": "SCAFFOLDING_MUTATION_BUN=1 scaffolding-mutation"
  },
  "devDependencies": {
    "@hackersandwizards/brand": "git+https://github.com/hackersandwizards/brand.git#v2.31.0",
    "@hackersandwizards/scaffolding": "git+https://github.com/hackersandwizards/scaffolding.git#v5.47.9",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.5",
    "@types/bun": "1.4.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "astro": "7.4.13",
    "astrobook": "0.13.3",
    "beautiful-mermaid": "1.1.3",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.2",
    "happy-dom": "21.0.4",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "puppeteer-core": "25.19.0",
    "stylelint": "18.1.0",
    "tailwindcss": "4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "scaffolding": {
    "browserTest": "test/pages",
    "licenses": {
      "elkjs": {
        "license": "EPL-2.0",
        "reason": "The hub runs the unmodified library locally at build time and conveys no copy."
      }
    },
    "brand": {
      "retired": [
        "dist"
      ]
    },
    "check": [
      "check:values",
      "check:scan",
      "check:fixture",
      "browser-test",
      "elements",
      "retired"
    ],
    "skip": {
      "admin": "this is admin: check:fixture runs admin-check on the invented fixture, and the repository keeps no items of its own"
    }
  },
  "peerDependencies": {
    "@hackersandwizards/brand": ">=2.16.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "beautiful-mermaid": "^1.1.3",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "@hackersandwizards/brand": {
      "optional": true
    },
    "@tailwindcss/typography": {
      "optional": true
    },
    "@tailwindcss/vite": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "beautiful-mermaid": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "overrides": {
    "minimatch": "11.0.9",
    "postcss-selector-parser": "7.2.1",
    "qs": "6.17.1"
  },
  "admin": {
    "label": "Admin engine"
  }
}
