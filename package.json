{
  "name": "@hackersandwizards/admin",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.0",
    "npm": "please-use-bun"
  },
  "bin": {
    "admin-serve": "bin/admin-serve.ts",
    "admin-check": "bin/admin-check.ts"
  },
  "exports": {},
  "files": [
    "bin",
    "src",
    "site/astro.config.ts",
    "site/src",
    "scripts/repo/only-bun.cjs"
  ],
  "scripts": {
    "prepare": "[ \"$(git rev-parse --show-toplevel 2>/dev/null)\" = \"$(pwd -P)\" ] && git config core.hooksPath .githooks || true",
    "dev": "bun bin/admin-serve.ts",
    "start": "bun run dev",
    "catalog": "ASTRO_DEV_BACKGROUND=1 bun --bun astro dev --root catalog",
    "build": "bun --bun astro build --root catalog",
    "check": "scaffolding check",
    "check:values": "bun test/no-values.ts",
    "check:fixture": "bun bin/admin-check.ts test/fixtures/spoke",
    "check:colours": "brand-colours",
    "check:copies": "brand-copies",
    "check:elements": "brand-elements",
    "check:staged": "check-staged",
    "fix": "bun --bun eslint --cache --concurrency=auto . --fix && bun --bun prettier --write .",
    "test": "bun test"
  },
  "dependencies": {
    "@hackersandwizards/brand": "git+https://github.com/hackersandwizards/brand.git#v1.0.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.4",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@hackersandwizards/scaffolding": "git+https://github.com/hackersandwizards/scaffolding.git#v1.0.0",
    "@types/bun": "1.4.4",
    "astrobook": "0.13.3",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "stylelint": "17.16.0",
    "typescript": "6.0.3"
  },
  "admin": {
    "designSystem": "http://127.0.0.1:4332/catalog/"
  },
  "scaffolding": {
    "test": "test",
    "check": [
      "check:values",
      [
        "check:colours",
        "check:copies"
      ],
      "check:fixture",
      "check:elements"
    ],
    "skip": {
      "admin": "this is admin: check:fixture runs admin-check on the invented fixture, and the repository keeps no items of its own"
    }
  }
}
