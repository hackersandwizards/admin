---
import "admin:styles";
import AppHeader from "@hackersandwizards/brand/expert/components/AppHeader.astro";
import favicon from "@hackersandwizards/brand/logos/favicon.svg?url";
import adminScript from "admin:script?url";
import themeScript from "../theme.js?url";
import {
  data,
  forPerson,
  hasPage,
  href,
  keyOf,
  NOTICE,
  openQuestions,
  repoOf,
  reviewsOf,
  type Page,
} from "../data";

interface Props {
  page: Page;
  lead?: string;
  provenance?: string;
  /** The page names every item of its repositories, so a copied answer to an item gone from them
   * was done. */
  answersAll?: boolean;
  /** What went wrong, where admin-serve fills it in on each page: the catalog shows it here. */
  notice?: string;
}
const { page, lead, provenance, answersAll = false, notice = NOTICE } = Astro.props;
const d = data();
const repo = repoOf(page.repo);
type Repo = NonNullable<typeof repo>;
const at = (to: string) => (to.startsWith("/") ? to : href(page.path, to));
const waiting = (r: Repo) => openQuestions(r.items).length + forPerson(r.items).length;
const menu = repo
  ? [
      { to: "", label: "Dashboard" },
      {
        to: "decisions",
        label: "Decisions",
        count: openQuestions(repo.items).length,
      },
      { to: "work", label: "Work", count: repo.items.filter((i) => i.kind === "work").length },
      { to: "reviews", label: "Reviews", count: reviewsOf(repo.items).length },
      { to: "docs", label: "Docs", count: repo.reports.length + repo.docs.length },
      ...(repo.designSystem ? [{ to: "catalog", label: "Catalog" }] : []),
      ...repo.products.map((p, n) => ({ to: `products-${n + 1}`, label: p.label })),
      { to: "architecture", label: "Architecture", count: repo.scripts.length || undefined },
      { to: "checks", label: "Checks", count: repo.checkSteps.length || undefined },
      { to: "log", label: "Log" },
    ].map((m) => ({ ...m, to: m.to ? repo.prefix + m.to : repo.dashboard }))
  : [
      { to: "index", label: "Needs a person", count: d.repos.reduce((n, r) => n + waiting(r), 0) },
      { to: "architecture", label: "Packages" },
      // admin-serve serves the engine's own catalog there.
      { to: "/catalog/", label: "Catalog" },
    ];
// A product page is its repo's own, so the switcher opens another repo's dashboard from it.
const samePage = (r: Repo) => {
  if (r.key === repo?.key) return page.path;
  const to = r.prefix + (page.type === "doc" ? "docs" : page.path.slice(repo!.prefix.length));
  return page.type !== "product" && hasPage(to) ? to : r.dashboard;
};
const current = (to: string) =>
  to === page.path || (page.type === "doc" && to === `${repo?.prefix}docs`);
const entries = [
  ...menu.map((m) => ({ ...m, href: at(m.to), current: current(m.to) })),
  ...(repo?.links ?? []).map((l) => ({
    label: l.label,
    href: l.href,
    current: false,
    count: undefined,
  })),
];
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title} · {repo ? repo.key : "hub"} · Admin</title>
    <meta name="description" content={lead ?? page.title} />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <script is:inline src={themeScript}></script>
  </head>
  <body
    class="hw-focus-ring bg-background text-foreground"
    data-hw-scale="dense"
    data-answers={
      answersAll
        ? (repo ? [repo] : d.repos).flatMap((r) => r.items.map(keyOf)).join(" ")
        : undefined
    }
  >
    <div class="sr-only focus-within:not-sr-only">
      <a class="hw-button" href="#admin-content">
        Skip to the content
      </a>
    </div>
    <AppHeader product="Admin" href={at("index")}>
      <nav class="hw-breadcrumb admin-where ml-auto" aria-label="Where">
        <ol>
          <li>
            {page.type === "hub" ? (
              <span aria-current="page">Hub</span>
            ) : (
              <a href={at("index")}>Hub</a>
            )}
          </li>
          <li>
            <button
              type="button"
              class="hw-button"
              data-variant="secondary"
              popovertarget="admin-repos"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-current={repo ? "location" : undefined}
            >
              <span class="truncate">{repo ? repo.key : "Repos"}</span>
              <span aria-hidden="true">&nbsp;▾</span>
            </button>
          </li>
        </ol>
      </nav>
      <div id="admin-repos" class="hw-menu" popover role="menu" aria-label="Repos">
        {d.repos.map((r) => (
          <a
            class="hw-menu-item"
            role="menuitemradio"
            aria-checked={String(r.key === repo?.key)}
            href={at(repo ? samePage(r) : r.dashboard)}
          >
            <span class="min-w-0 flex-1 truncate">{r.key}</span>
            <span class="hw-nav-count">{waiting(r) || ""}</span>
          </a>
        ))}
      </div>
    </AppHeader>
    <div class="admin-shell hw-container">
      <aside class="admin-rail">
        <div class="hw-search admin-search">
          <input
            id="admin-search"
            type="search"
            class="hw-field"
            placeholder="Search /"
            aria-label="Search this page"
          />
        </div>
        <nav class="hw-choices admin-choices md:hidden" aria-label="Menu">
          {entries.map((e) => (
            <a class="hw-choice" href={e.href} aria-current={e.current ? "page" : undefined}>
              {e.label}
              {e.count !== undefined && <span class="hw-choice-count">{e.count}</span>}
            </a>
          ))}
        </nav>
        <nav class="hw-nav max-md:hidden" aria-label="Menu">
          {repo && <a href={at("index")}>← Hub</a>}
          <p class="hw-label hw-nav-group" data-tone="muted">
            {repo ? repo.key : "Hub"}
          </p>
          <ul>
            {entries.map((e) => (
              <li>
                <a href={e.href} aria-current={e.current ? "page" : undefined}>
                  {e.label}
                  {e.count !== undefined && <span class="hw-nav-count">{e.count}</span>}
                </a>
              </li>
            ))}
          </ul>
          {!repo && (
            <>
              <p class="hw-label hw-nav-group" data-tone="muted">
                Repos
              </p>
              <ul>
                {d.repos.map((r) => (
                  <li>
                    <a href={at(r.dashboard)}>
                      {r.key}
                      <span class="hw-nav-count">{waiting(r) || ""}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )}
        </nav>
      </aside>
      <main class="admin-main pb-16">
        <h1>{page.title}</h1>
        {lead && <p class="admin-lead">{lead}</p>}
        {provenance && <p class="admin-provenance text-foreground/70">{provenance}</p>}
        {Astro.slots.has("action") && (
          <div class="admin-action bg-background">
            <slot name="action" />
          </div>
        )}
        <div
          id="admin-problem"
          class="hw-callout mt-3 flex flex-col gap-1 text-ui empty:hidden"
          role="status"
          set:html={notice}
        />
        <p id="admin-age" class="hw-status mt-3 text-ui" data-tone="warning" hidden></p>
        <p id="admin-gone" class="hw-status mt-3 text-ui" data-tone="info" hidden></p>
        <p id="admin-since" class="mt-3 text-ui text-accent" hidden></p>
        <p id="admin-nohit" class="mt-3 text-ui" role="status" hidden></p>
        <div id="admin-content" class="mt-6 flex flex-col gap-8" tabindex="-1">
          <slot />
        </div>
      </main>
    </div>
    <script is:inline src={adminScript}></script>
  </body>
</html>
