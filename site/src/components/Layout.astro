---
// The admin shell: brand's internal header over the shell's own layout (layout.css): the rail with
// search, the repository's menu with counts and, in the hub, the other repositories; then title,
// lead and provenance. Every colour, font and size role comes from brand: tokens, the expert set,
// the elements at the dense scale with its compact tier.
import "admin:styles";
import AppHeader from "@hackersandwizards/brand/expert/components/AppHeader.astro";
import { navLinkClass } from "@hackersandwizards/brand/expert/components/space-nav.ts";
import script from "../admin.js?raw";
import { data, forPerson, href, openQuestions, repoOf, type Page } from "../data";

interface Props {
  page: Page;
  lead?: string;
  provenance?: string;
  /** The page lists every question of its repositories, so an answer whose row is gone was done. */
  answersAll?: boolean;
}
const { page, lead, provenance, answersAll = false } = Astro.props;
const d = data();
const repo = repoOf(page.repo);
const home = d.hub ? "index" : (repo?.dashboard ?? "index");
const at = (to: string) => href(page.path, to);
const menu = repo
  ? [
      { to: "", label: "Dashboard" },
      {
        to: "decisions",
        label: "Decisions",
        count: openQuestions(repo.items).length,
      },
      { to: "work", label: "Work", count: repo.items.filter((i) => i.kind === "work").length },
      { to: "reviews", label: "Reviews", count: repo.reviews.length },
      { to: "docs", label: "Docs", count: repo.reports.length + repo.docs.length },
      ...(repo.designSystem ? [{ to: "catalog", label: "Catalog" }] : []),
      ...repo.products.map((p, n) => ({ to: `products-${n + 1}`, label: p.label })),
      { to: "architecture", label: "Architecture", count: repo.scripts.length || undefined },
      { to: "checks", label: "Checks", count: repo.checkSteps.length || undefined },
      { to: "log", label: "Log" },
    ].map((m) => ({ ...m, to: m.to ? repo.prefix + m.to : repo.dashboard }))
  : [
      {
        to: "index",
        label: "Needs a person",
        count: d.repos.reduce(
          (n, r) => n + openQuestions(r.items).length + forPerson(r.items).length,
          0,
        ),
      },
      { to: "architecture", label: "Packages" },
    ];
// The current entry wears space-nav's active link, the rail link of every expert app.
const active = navLinkClass("x", "x")[1];
const current = (to: string) =>
  to === page.path || (page.type === "doc" && to === `${repo?.prefix}docs`);
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title} · {repo ? repo.key : "hub"} · Admin</title>
    <script is:inline>
      if (matchMedia("(prefers-color-scheme: dark)").matches)
        document.documentElement.dataset.theme = "dark";
    </script>
  </head>
  <body
    class="bg-background text-foreground"
    data-hw-scale="dense"
    data-answers={answersAll ? "all" : undefined}
  >
    <AppHeader product="Admin" href={at(home)}>
      <nav class="ml-auto flex items-center gap-1 text-ui" aria-label="Where">
        {d.hub && (
          <a
            href={at("index")}
            class:list={navLinkClass(at("index"), page.type.startsWith("hub") ? at("index") : "")}
          >
            Hub
          </a>
        )}
        {repo && (
          <a href={at(repo.dashboard)} class:list={navLinkClass("x", "x")}>
            {repo.key}
          </a>
        )}
      </nav>
    </AppHeader>
    <div class="admin-shell hw-container">
      <aside class="admin-rail">
        <input
          id="admin-search"
          type="search"
          class="admin-search"
          placeholder="Search /"
          aria-label="Search this page"
        />
        <nav aria-label="Menu">
          <p class="hw-label mb-1 px-2">{repo ? repo.key : "hub"}</p>
          <ul>
            {menu.map((m) => (
              <li>
                <a
                  href={at(m.to)}
                  aria-current={current(m.to) ? "page" : undefined}
                  class:list={current(m.to) && active}
                >
                  <span>{m.label}</span>
                  {m.count !== undefined && <span class="admin-count">{m.count}</span>}
                </a>
              </li>
            ))}
            {repo?.links.map((l) => (
              <li>
                <a href={l.href}>
                  <span>{l.label}</span>
                </a>
              </li>
            ))}
          </ul>
          {d.hub && (
            <>
              <p class="hw-label mt-6 mb-1 px-2">Repos</p>
              <ul>
                {d.repos.map((r) => (
                  <li>
                    <a
                      href={at(r.dashboard)}
                      aria-current={r.key === repo?.key ? "true" : undefined}
                      class:list={r.key === repo?.key && active}
                    >
                      <span>{r.key}</span>
                      <span class="admin-count">
                        {openQuestions(r.items).length + forPerson(r.items).length || ""}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )}
        </nav>
      </aside>
      <main class="admin-main pb-16">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h1>{page.title}</h1>
          <div class="flex items-center gap-3">
            <slot name="action" />
          </div>
        </div>
        {lead && <p class="admin-lead">{lead}</p>}
        {provenance && <p class="admin-provenance">{provenance}</p>}
        <div class="mt-6 flex flex-col gap-8">
          <slot />
        </div>
      </main>
    </div>
    <script is:inline set:html={script} />
  </body>
</html>
