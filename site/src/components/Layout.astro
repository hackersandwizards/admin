---
// Every colour, font and size role comes from brand: tokens, the expert set, the elements at the
// dense scale with its compact tier.
// Navigation (blind review 2026-11-06, two rounds, over the rail that switched between the hub's
// and a repo's menu): the top bar says where you are, "Hub / <repo> ▾", and its switcher opens
// another repo on the same page; the rail holds only the current place's pages, a repo's under a
// way back to the hub.
import "admin:styles";
import AppHeader from "@hackersandwizards/brand/expert/components/AppHeader.astro";
import { navLinkClass } from "@hackersandwizards/brand/expert/components/space-nav.ts";
import adminScript from "../admin.js?url";
import themeScript from "../theme.js?url";
import { data, forPerson, hasPage, href, openQuestions, repoOf, type Page } from "../data";

interface Props {
  page: Page;
  lead?: string;
  provenance?: string;
  /** The page lists every question of its repositories, so an answer whose row is gone was done. */
  answersAll?: boolean;
}
const { page, lead, provenance, answersAll = false } = Astro.props;
const d = data();
const repo = repoOf(page.repo);
type Repo = NonNullable<typeof repo>;
const at = (to: string) => href(page.path, to);
const waiting = (r: Repo) => openQuestions(r.items).length + forPerson(r.items).length;
const menu = repo
  ? [
      { to: "", label: "Dashboard" },
      {
        to: "decisions",
        label: "Decisions",
        count: openQuestions(repo.items).length,
      },
      { to: "work", label: "Work", count: repo.items.filter((i) => i.kind === "work").length },
      { to: "reviews", label: "Reviews", count: repo.reviews.length },
      { to: "docs", label: "Docs", count: repo.reports.length + repo.docs.length },
      ...(repo.designSystem ? [{ to: "catalog", label: "Catalog" }] : []),
      ...repo.products.map((p, n) => ({ to: `products-${n + 1}`, label: p.label })),
      { to: "architecture", label: "Architecture", count: repo.scripts.length || undefined },
      { to: "checks", label: "Checks", count: repo.checkSteps.length || undefined },
      { to: "log", label: "Log" },
    ].map((m) => ({ ...m, to: m.to ? repo.prefix + m.to : repo.dashboard }))
  : [
      { to: "index", label: "Needs a person", count: d.repos.reduce((n, r) => n + waiting(r), 0) },
      { to: "architecture", label: "Packages" },
    ];
// The page a repo opens on from the switcher: the current repo stays on this page, another opens
// on the same page where it has one, on its Docs from a doc, else on its dashboard. A product page
// is its repo's own.
const samePage = (r: Repo) => {
  if (r.key === repo?.key) return page.path;
  const to = r.prefix + (page.type === "doc" ? "docs" : page.path.slice(repo!.prefix.length));
  return page.type !== "product" && hasPage(to) ? to : r.dashboard;
};
// The current entry wears space-nav's active link, the rail link of every expert app.
const active = navLinkClass("x", "x")[1];
const current = (to: string) =>
  to === page.path || (page.type === "doc" && to === `${repo?.prefix}docs`);
---

<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title} · {repo ? repo.key : "hub"} · Admin</title>
    <script is:inline src={themeScript}></script>
  </head>
  <body
    class="hw-focus-ring bg-background text-foreground"
    data-hw-scale="dense"
    data-answers={answersAll ? "all" : undefined}
  >
    <AppHeader product="Admin" href={at("index")}>
      <nav class="hw-breadcrumb admin-where ml-auto" aria-label="Where">
        <ol>
          <li>
            {page.type === "hub" ? (
              <span aria-current="page">Hub</span>
            ) : (
              <a href={at("index")}>Hub</a>
            )}
          </li>
          <li>
            <button
              type="button"
              class="admin-switch"
              popovertarget="admin-repos"
              aria-current={repo ? "location" : undefined}
            >
              {repo ? repo.key : "Repos"} <span aria-hidden="true">▾</span>
            </button>
          </li>
        </ol>
      </nav>
      <ul id="admin-repos" class="admin-repos" popover aria-label="Repos">
        {d.repos.map((r) => (
          <li>
            <a
              href={at(repo ? samePage(r) : r.dashboard)}
              aria-current={r.key === repo?.key ? "true" : undefined}
            >
              <span>{r.key}</span>
              <span class="admin-count">{waiting(r) || ""}</span>
            </a>
          </li>
        ))}
      </ul>
    </AppHeader>
    <div class="admin-shell hw-container">
      <aside class="admin-rail">
        <input
          id="admin-search"
          type="search"
          class="admin-search"
          placeholder="Search /"
          aria-label="Search this page"
        />
        <nav aria-label="Menu">
          {repo && (
            <a href={at("index")} class="admin-back">
              ← Hub
            </a>
          )}
          <p class="hw-label mb-1 px-2">{repo ? repo.key : "Hub"}</p>
          <ul>
            {menu.map((m) => (
              <li>
                <a
                  href={at(m.to)}
                  aria-current={current(m.to) ? "page" : undefined}
                  class:list={current(m.to) && active}
                >
                  <span>{m.label}</span>
                  {m.count !== undefined && <span class="admin-count">{m.count}</span>}
                </a>
              </li>
            ))}
            {repo?.links.map((l) => (
              <li>
                <a href={l.href}>
                  <span>{l.label}</span>
                </a>
              </li>
            ))}
          </ul>
          {!repo && (
            <>
              <p class="hw-label mt-6 mb-1 px-2" data-repos>
                Repos
              </p>
              <ul data-repos>
                {d.repos.map((r) => (
                  <li>
                    <a href={at(r.dashboard)}>
                      <span>{r.key}</span>
                      <span class="admin-count">{waiting(r) || ""}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )}
        </nav>
      </aside>
      <main class="admin-main pb-16">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h1>{page.title}</h1>
          <div class="flex items-center gap-3">
            <slot name="action" />
          </div>
        </div>
        {lead && <p class="admin-lead">{lead}</p>}
        {provenance && <p class="admin-provenance">{provenance}</p>}
        <div class="mt-6 flex flex-col gap-8">
          <slot />
        </div>
      </main>
    </div>
    <script is:inline src={adminScript}></script>
  </body>
</html>
