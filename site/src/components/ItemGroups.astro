---
import ItemRow from "./ItemRow.astro";
import LinkRow from "./LinkRow.astro";
import type { ViewItem } from "../data";

interface Props {
  items: ViewItem[];
  showRepo?: boolean;
  /** Rows as links to the item on its repository's page, which `from` starts from. */
  from?: string;
  /** Priorities whose group starts open. */
  openUpTo?: number;
  /** One group under this title instead of groups by priority. */
  title?: string;
  /** The titled group's id, which a link to it names after #. */
  id?: string;
}
const { items, showRepo = false, from, openUpTo = 2, title, id } = Astro.props;
const groups = title
  ? [{ label: title, rows: items, open: false }]
  : [1, 2, 3, undefined].map((p) => ({
      label: p ? `Priority ${p}` : "Without priority",
      rows: items.filter((i) => i.priority === p),
      open: (p ?? 9) <= openUpTo,
    }));
---

{groups
  .filter((g) => g.rows.length)
  .map((g) => (
    <details class="hw-disclosure" id={title ? id : undefined} data-group open={g.open}>
      <summary class="py-2 font-mono font-semibold text-ui">
        {g.label}{" "}
        <span class="ml-1 font-normal text-foreground/70" data-count>
          {g.rows.length}
        </span>
        <span class="ml-1 font-normal text-accent" data-updated-count hidden></span>
      </summary>
      <div class="hw-card p-0!" data-hw-exception="item-list">
        {g.rows.map((i) =>
          from ? <LinkRow item={i} from={from} /> : <ItemRow item={i} showRepo={showRepo} />,
        )}
      </div>
    </details>
  ))}
