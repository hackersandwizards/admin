---
// An opened question shows what is asked and its options first, its context below them. Options
// with images are cards; options without are one dense list, so a long list of candidates stays
// scannable.
import { askedOf, data, dueOf, inline, keyOf, withLinks, UPDATED, type ViewItem } from "../data";
import Choice from "./Choice.astro";
import Shot from "./Shot.astro";

interface Props {
  item: ViewItem;
  showRepo?: boolean;
  open?: boolean;
}
const { item: i, showRepo = false, open = false } = Astro.props;
const k = keyOf(i);
const options = i.options ?? [];
const shots = (key: string) => i.optionImages[key] ?? [];
const carded = options.some((o) => shots(o.key).length);
// The options answer the item's question, which names their group for a screen reader.
const group = i.multiple ? "group" : "radiogroup";
// The item's own images, above the answer: what a review asks about is in view where it is answered.
const loose = shots("");
const score = (o: (typeof options)[number]) =>
  o.score === undefined ? "" : `${o.score}${o.noise === undefined ? "" : ` ± ${o.noise}`}`;
// A row without "for <owner>" is the hub's user's alone.
const meta = [
  showRepo ? i.repoLabel : "",
  i.status !== "open"
    ? `${i.kind}${i.priority ? `, P${i.priority}` : ""}`
    : { decision: "to decide", review: "to review", work: "to do" }[i.kind],
  options.length ? `${options.length} options${i.multiple ? ", pick several" : ""}` : "",
  i.owner && i.owner !== data().people[0] ? `for ${i.owner}` : "",
].filter(Boolean);
const due = i.due ? dueOf(i.due) : undefined;
// The body's first paragraph says what the owner does; the rest is context.
const html = withLinks(i.html);
const lead = html.match(/^\s*<p>[\s\S]*?<\/p>/)?.[0] ?? "";
const context = html.slice(lead.length).trim();
// A decision written as an option's key reads as that option's label.
const named = options.find((o) => o.key === i.decision?.trim());
const decided = named ? `${named.label} (${named.key})` : i.decision;
// What was assumed: the assumption, else on an assumed item its recommended options, every label.
const assumed =
  i.assumption ??
  (i.status === "assumed"
    ? options
        .filter((o) => i.recommendedKeys.includes(o.key))
        .map((o) => o.label)
        .join(", ") || undefined
    : undefined);
// What a settled row's closed line says: what was assumed or decided, never the recommendation.
const settledAs =
  i.status === "assumed"
    ? { label: "Assumed", text: assumed }
    : i.status === "decided"
      ? { label: `Decided by ${i.by}`, text: decided }
      : undefined;
const body = "hw-measure flex flex-col gap-3 [&_ol]:list-decimal [&_ol]:pl-4";
---

<details
  class="item group hw-disclosure border-b border-border last:border-b-0"
  id={k}
  data-k={k}
  data-who={i.agent ? undefined : i.who}
  data-changed={i.changed}
  data-version={i.version}
  data-asked={askedOf(i)}
  data-kind={i.kind}
  data-repo={i.repo}
  data-status={i.status}
  data-row
  open={open}
>
  <summary class="flex items-start gap-3 px-3 py-2">
    {i.kind === "goal" || i.status !== "open" ? (
      <span class="hw-label shrink-0">{i.kind === "goal" ? "Goal" : i.status}</span>
    ) : (
      <span
        class="hw-pill shrink-0"
        data-priority={i.priority}
        data-variant={i.priority ? undefined : "outline"}
      >
        P{i.priority ?? "–"}
      </span>
    )}
    <span class="min-w-0 flex-1 sm:contents">
      <span class="block sm:min-w-0 sm:flex-1">
        <span class="block font-medium text-ui">{i.title}</span>
        {settledAs
          ? settledAs.text && (
              <span class="text-ui line-clamp-2 group-open:hidden">
                {settledAs.label}: <Fragment set:html={inline(settledAs.text)} />
              </span>
            )
          : i.recommendedLabel && (
              <span class="block text-ui group-open:hidden">Recommended: {i.recommendedLabel}</span>
            )}
        <span class="block text-ui text-foreground/70">
          <span class="text-accent" data-updated hidden>
            {UPDATED} ·
          </span>{" "}
          {meta.join(" · ")}
        </span>
      </span>
      <span class="flex flex-wrap items-center gap-x-3 gap-y-1 has-[:not(:empty)]:mt-1 sm:contents">
        {due && (
          <span
            class:list={["hw-pill shrink-0", `admin-due-${due.tone}`]}
            data-tone={due.tone === "later" ? "neutral" : undefined}
          >
            {due.text}
          </span>
        )}
        <span class="mark shrink-0 text-micro text-accent empty:hidden"></span>
        {i.area && (
          <span class="hw-pill shrink-0" data-variant="outline" title="area">
            {i.area}
          </span>
        )}
      </span>
    </span>
  </summary>
  <div class="hw-measure flex flex-col gap-4 px-3 pb-4 text-ui lg:pl-16">
    <p class="hw-status" data-tone="warning" data-stale hidden></p>
    {assumed && (
      <p class="hw-callout">
        <b>Assumed:</b> <Fragment set:html={inline(assumed)} />
      </p>
    )}
    {i.decision && (
      <p class="hw-callout">
        <b>Decided by {i.by}:</b> <Fragment set:html={inline(decided!)} />
      </p>
    )}
    {lead && <div class={body} set:html={lead} />}
    {loose.length > 0 && (
      <div class:list={["grid gap-3", loose.length > 1 && "sm:grid-cols-2"]}>
        {loose.map((m) => (
          <Shot {...m} alt={m.caption ?? i.title} />
        ))}
      </div>
    )}
    {i.status === "assumed" && (
      <div
        class="hw-card p-0!"
        data-hw-exception="option-list"
        role="radiogroup"
        aria-label={`${i.title}: agree or veto`}
      >
        {[
          ["agree", "Agree", "The assumption stands."],
          [
            "veto",
            "Veto",
            options.length
              ? "Undo it: pick another option below, or say why in the note."
              : "Undo it: say why in the note.",
          ],
        ].map(([key, label, detail]) => (
          <label class="flex cursor-pointer border-b border-border px-3 py-1.5 last:border-b-0 has-checked:bg-muted">
            <span class="flex w-full items-start gap-2">
              <input type="radio" name={`${k}-stance`} value={key} data-stance class="hw-check" />
              <span class="min-w-0 flex-1">
                <b>{label}</b>
                <span class="block text-foreground/70">{detail}</span>
              </span>
            </span>
          </label>
        ))}
      </div>
    )}
    <p class="flex flex-wrap items-center gap-2 not-has-[button:not([hidden])]:-mt-4">
      {i.recommendedKeys.length > 0 && i.status !== "assumed" && (
        <button
          type="button"
          class="pick hw-button"
          data-variant="secondary"
          data-v={i.recommendedKeys.join(" ")}
        >
          Pick recommended
        </button>
      )}
      <button type="button" class="clear hw-button" data-variant="secondary" hidden>
        Reset
      </button>
      <span class="saved text-micro text-foreground/70" aria-live="polite"></span>
    </p>
    {carded && (
      <div
        class={`grid gap-2 ${options.length > 1 ? "md:grid-cols-2" : ""} ${options.length > 2 ? "xl:grid-cols-3" : ""}`}
        role={group}
        aria-label={i.title}
      >
        {options.map((o) => (
          <label class="hw-card flex cursor-pointer flex-col gap-2 has-checked:border-accent">
            {shots(o.key).length > 0 && (
              <span
                class={`grid gap-1 ${["", "", "grid-cols-2"][shots(o.key).length] ?? (options.length > 2 ? "grid-cols-2" : "grid-cols-3")}`}
              >
                {shots(o.key).map((m) => (
                  <Shot {...m} alt={m.caption ?? o.label} small={options.length > 1} />
                ))}
              </span>
            )}
            <Choice item={i} option={o} name={k} score={score(o)} />
          </label>
        ))}
      </div>
    )}
    {options.length > 0 && !carded && (
      <div class="hw-card p-0!" data-hw-exception="option-list" role={group} aria-label={i.title}>
        {options.map((o) => (
          <label
            class="flex cursor-pointer border-b border-border px-3 py-1.5 last:border-b-0 has-checked:bg-muted"
            data-option-row
          >
            <Choice item={i} option={o} name={k} score={score(o)} />
          </label>
        ))}
      </div>
    )}
    {i.kind === "work" && (
      <label class="flex items-start gap-2">
        <input type="checkbox" class="hw-check" data-done /> done
      </label>
    )}
    {i.status === "open" && (
      <label class="flex items-start gap-2">
        <input type="checkbox" class="hw-check" data-later /> Decide later: ask me again on my next
        visit
      </label>
    )}
    <label class="text-micro text-foreground/70" for={`n-${k}`}>
      {options.length ? "Note or your own answer" : "Answer, such as “fine” or what to change"}
    </label>
    <textarea id={`n-${k}`} class="form-input w-full"></textarea>
    {(context || i.evidence) && (
      <>
        <p class="hw-label" data-tone="muted">
          Context
        </p>
        {context && (
          <div
            class={`${body} [&_h1]:font-semibold [&_h1]:text-subheading [&_h2]:font-semibold [&_h2]:text-subheading [&_h3]:font-semibold [&_h4]:font-semibold not-in-data-[theme=dark]:[--hw-table-ground:var(--color-white)]`}
            set:html={context}
          />
        )}
        {i.evidence && (
          <p class="text-foreground/70">
            Evidence: <Fragment set:html={inline(i.evidence)} />
          </p>
        )}
      </>
    )}
  </div>
</details>
