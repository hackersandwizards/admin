---
// Options with images are cards; options without are one dense list, so a long list of candidates
// stays scannable.
import { dueSoon } from "../../../src/items.ts";
import { day, keyOf, type ViewItem } from "../data";
import Choice from "./Choice.astro";
import Shot from "./Shot.astro";

interface Props {
  item: ViewItem;
  showRepo?: boolean;
  open?: boolean;
}
const { item: i, showRepo = false, open = false } = Astro.props;
const k = keyOf(i);
const options = i.options ?? [];
const shots = (key: string) => i.optionImages[key] ?? [];
const carded = options.some((o) => shots(o.key).length);
const score = (o: (typeof options)[number]) =>
  o.score === undefined ? "" : `${o.score}${o.noise === undefined ? "" : ` ± ${o.noise}`}`;
const meta = [
  showRepo ? i.repo : "",
  i.status === "open" ? i.kind : i.status,
  options.length ? `${options.length} options${i.multiple ? ", pick several" : ""}` : "",
  i.owner ? `for ${i.owner}` : "",
  i.recommendedLabel ? `recommended: ${i.recommendedLabel}` : "",
].filter(Boolean);
const soon = dueSoon(i.due);
---

<details
  class="item hw-disclosure border-b border-border last:border-b-0"
  id={k}
  data-k={k}
  data-who={i.agent ? undefined : i.who}
  data-row
  open={open}
>
  <summary class="flex items-start gap-3 px-3 py-2">
    {i.kind === "goal" ? (
      <span class="hw-label shrink-0">Goal</span>
    ) : (
      <span
        class="hw-pill shrink-0 font-mono"
        data-priority={i.priority}
        data-variant={i.priority ? undefined : "outline"}
        data-hw-exception="priority-pill"
      >
        P{i.priority ?? "–"}
      </span>
    )}
    <span class="min-w-0 flex-1">
      <span class="block font-medium text-ui">{i.title}</span>
      <span class="block text-ui text-foreground/70">{meta.join(" · ")}</span>
    </span>
    {i.due && (
      <span class="hw-pill shrink-0" data-tone={soon ? undefined : "neutral"}>
        due {day(Date.parse(i.due) / 1000)}
      </span>
    )}
    <span class="mark shrink-0 text-micro text-accent"></span>
    {i.area && <span class="shrink-0 text-ui text-foreground/70">{i.area}</span>}
  </summary>
  <div class="flex flex-col gap-4 px-3 pb-4 text-ui lg:pl-16">
    {i.assumption && (
      <p class="hw-callout max-w-measure">
        <b>Assumed:</b> {i.assumption}
      </p>
    )}
    {i.decision && (
      <p class="hw-callout max-w-measure">
        <b>Decided by {i.by}:</b> {i.decision}
      </p>
    )}
    <div
      class="flex flex-col gap-3 [&_li]:max-w-measure [&_ol]:list-decimal [&_ol]:pl-4 [&_p]:max-w-measure"
      set:html={i.html}
    />
    {i.evidence && <p class="text-foreground/70">Evidence: {i.evidence}</p>}
    {shots("").length > 0 && (
      <div class="grid grid-cols-2 gap-3 xl:grid-cols-3">
        {shots("").map((m) => (
          <Shot {...m} alt={m.caption ?? i.title} />
        ))}
      </div>
    )}
    {carded && (
      <div
        class={`grid gap-2 ${options.length > 1 ? "md:grid-cols-2" : ""} ${options.length > 2 ? "xl:grid-cols-3" : ""}`}
      >
        {options.map((o) => (
          <label class="hw-card flex cursor-pointer flex-col gap-2 has-checked:border-accent">
            {shots(o.key).length > 0 && (
              <span
                class={`grid gap-1 ${["", "", "grid-cols-2"][shots(o.key).length] ?? (options.length > 2 ? "grid-cols-2" : "grid-cols-3")}`}
              >
                {shots(o.key).map((m) => (
                  <Shot {...m} alt={m.caption ?? o.label} small={options.length > 1} />
                ))}
              </span>
            )}
            <Choice item={i} option={o} name={k} score={score(o)} />
          </label>
        ))}
      </div>
    )}
    {options.length > 0 && !carded && (
      <div class="hw-card p-0!" data-hw-exception="option-list">
        {options.map((o) => (
          <label
            class="flex cursor-pointer border-b border-border px-3 py-1.5 last:border-b-0 has-checked:bg-muted"
            data-option-row
          >
            <Choice item={i} option={o} name={k} score={score(o)} />
          </label>
        ))}
      </div>
    )}
    {i.kind === "work" && (
      <label class="flex items-start gap-2">
        <input type="checkbox" class="hw-check" value="done" /> done
      </label>
    )}
    <label class="text-micro text-foreground/70" for={`n-${k}`}>
      {options.length ? "Note or your own answer" : "Answer, such as “fine” or what to change"}
    </label>
    <textarea id={`n-${k}`} class="form-input w-full"></textarea>
    <p class="flex flex-wrap items-center gap-2">
      {i.recommendedKeys.length > 0 && (
        <button
          type="button"
          class="pick hw-button"
          data-variant="secondary"
          data-v={i.recommendedKeys.join(" ")}
        >
          Pick recommended
        </button>
      )}
      <button type="button" class="clear hw-button" data-variant="secondary">
        Reset
      </button>
      <span class="saved text-micro text-foreground/70" aria-live="polite"></span>
    </p>
  </div>
</details>
