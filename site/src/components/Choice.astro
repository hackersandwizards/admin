---
import { inline, type ViewItem } from "../data";

interface Props {
  item: ViewItem;
  option: NonNullable<ViewItem["options"]>[number];
  name: string;
  score: string;
  /** The input's id, where a label around more than the input names it. */
  id?: string;
}
const { item, option: o, name, score, id } = Astro.props;
// An item's text names an option by a letter key, such as "b"; a word key restates its label.
const lettered = /^[a-z]\d*$/i.test(o.key);
---

<span class="flex w-full items-start gap-2">
  <input
    type={item.multiple ? "checkbox" : "radio"}
    name={name}
    value={o.key}
    id={id}
    data-label={o.label}
    data-option
    class="hw-check"
  />
  <span class="min-w-0 flex-1">
    {item.recommendedKeys.includes(o.key) && (
      <span class="hw-pill" data-caps>
        Recommended
      </span>
    )}{" "}
    {lettered && (
      <span class="font-mono text-foreground/70" data-option-key>
        {o.key}
      </span>
    )}{" "}
    <b>{o.label}</b>
    {o.detail && (
      <span class="block max-w-measure text-foreground/70" set:html={inline(o.detail)} />
    )}
  </span>
  {score && (
    <span class="shrink-0 font-mono font-semibold" title="blind-review score">
      {score}
    </span>
  )}
</span>
