---
// Open items that people other than the hub's user own, one group per person, the person with the
// most urgent item first, each row linking to the item on its repo's page. A person the filter
// selects has their rows under "Needs you", so their group here hides (admin.js).
import { compareItems } from "../../../src/items.ts";
import { data } from "../data";
import LinkRow from "./LinkRow.astro";

interface Props {
  /** The page the links start from. */
  from: string;
  /** Only this repository's items, on its dashboard. */
  repo?: string;
}
const { from, repo } = Astro.props;
const d = data();
const waiting = d.repos
  .filter((r) => !repo || r.key === repo)
  .flatMap((r) => r.items.filter((i) => i.status === "open" && d.others.includes(i.who)))
  .sort(compareItems);
// Insertion order: each person where their most urgent item stands.
const groups = [...Map.groupBy(waiting, (i) => i.who)].map(([who, rows]) => ({ who, rows }));
---

{groups.length > 0 && (
  <section class="flex flex-col gap-2">
    <h2 class="font-mono font-semibold text-heading">Waiting on others</h2>
    {groups.map((g) => (
      <details class="hw-disclosure" data-group data-who-group={g.who} open>
        <summary class="py-2 font-mono font-semibold text-ui">
          {g.who}{" "}
          <span class="ml-1 font-normal text-foreground/70" data-count>
            {g.rows.length}
          </span>
        </summary>
        <div class="hw-card p-0!" data-hw-exception="item-list">
          {g.rows.map((i) => (
            <LinkRow item={i} from={from} />
          ))}
        </div>
      </details>
    ))}
  </section>
)}
