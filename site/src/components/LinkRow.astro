---
// An item as one line linking to its full row on its repository's page, for a list the person
// reads but does not answer on this page.
import { dueSoon } from "../../../src/items.ts";
import { day, itemHref, keyOf, UPDATED, type ViewItem } from "../data";

interface Props {
  item: ViewItem;
  /** The page the link starts from. */
  from: string;
}
const { item: i, from } = Astro.props;
const meta = [i.repo, i.kind, i.agent || i.owner !== i.who ? i.owner : ""]
  .filter(Boolean)
  .join(" · ");
---

<div
  class="flex items-start gap-3 border-b border-border px-3 py-2 last:border-b-0"
  data-k={keyOf(i)}
  data-changed={i.changed}
  data-version={i.version}
  data-row
>
  <span
    class="hw-pill shrink-0"
    data-priority={i.priority}
    data-variant={i.priority ? undefined : "outline"}
  >
    {i.kind === "goal" ? "Goal" : `P${i.priority ?? "–"}`}
  </span>
  <span class="min-w-0 flex-1">
    <a class="hw-link block font-medium text-ui" href={itemHref(from, i)}>
      {i.title}
    </a>
    <span class="block text-ui text-foreground/70">
      {[
        <span class="text-accent" data-updated hidden>
          {UPDATED}
        </span>,
        meta,
      ]}
    </span>
  </span>
  {i.due && (
    <span class="hw-pill shrink-0" data-tone={dueSoon(i.due) ? undefined : "neutral"}>
      due {day(Date.parse(i.due) / 1000)}
    </span>
  )}
</div>
